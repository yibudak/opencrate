1 ICON "../../assets/branding/opencrate-icon.ico"

1 VERSIONINFO
FILEVERSION OPENCRATE_VERSION_NUMBERS
PRODUCTVERSION OPENCRATE_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenCrate contributors"
            VALUE "FileDescription", "OpenCrate hardware control"
            VALUE "FileVersion", OPENCRATE_VERSION
            VALUE "InternalName", "opencrate-ui"
            VALUE "LegalCopyright", "Copyright (c) 2026 OpenCrate contributors"
            VALUE "OriginalFilename", "OpenCrate.exe"
            VALUE "ProductName", "OpenCrate"
            VALUE "ProductVersion", OPENCRATE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
